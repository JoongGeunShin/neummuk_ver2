# ══════════════════════════════════════════════════════════════
# 내움먹 (neummuk) — API Key 설정 예시
# ──────────────────────────────────────────────────────────────
# 1. 이 파일을 복사해서 .env 로 이름을 바꾸세요.
# 2. 각 항목의 값을 실제 키로 채워주세요.
# 3. .env 파일은 절대 git 에 커밋하지 마세요. (.gitignore 에 포함됨)
# ══════════════════════════════════════════════════════════════


# ── Firebase ──────────────────────────────────────────────────
# Firebase Console > 프로젝트 설정 > 일반 탭에서 확인
# Android: google-services.json / iOS: GoogleService-Info.plist 도 필요
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=AIzaSy_your_web_api_key

# Android 앱 (google-services.json > client > client_info > mobilesdk_app_id)
FIREBASE_ANDROID_APP_ID=1:000000000000:android:your_android_app_id

# iOS 앱 (GoogleService-Info.plist > GOOGLE_APP_ID)
FIREBASE_IOS_APP_ID=1:000000000000:ios:your_ios_app_id


# ── Kakao ─────────────────────────────────────────────────────
# Kakao Developers > 내 애플리케이션 > 앱 키
# REST API 키: Kakao Local API (장소 검색, 좌표 변환) + Kakao Mobility API (경로)
KAKAO_REST_API_KEY=your_kakao_rest_api_key


# ── Naver ──────────────────────────────────────────────────────
# 네이버 클라우드 플랫폼 > AI·NAVER API > Maps > Mobile Dynamic Map
# 콘솔: https://console.ncloud.com/naver-service/application
# Android 패키지명: com.example.neummuk_ver2 등록 필요
NAVER_MAP_CLIENT_ID=your_naver_map_client_id
# 네이버 클라우드 플랫폼 콘솔 > Style Set 에서 다크/라이트 스타일을 각각 만들어 ID를 채운다
NAVER_MAP_STYLE_DARK_ID=
NAVER_MAP_STYLE_BRIGHT_ID=
# 콘솔에서 스타일 발행 시 같이 표시되는 Version 값 — 참고용으로만 보관.
# flutter_naver_map 플러그인의 customStyleId API가 버전 파라미터를 받지 않아
# 현재 앱 코드에서는 사용하지 않는다 (Dynamic Map(Web JS) SDK 등에서 필요할 때 참고).
NAVER_MAP_VERSION_DARK_ID=
NAVER_MAP_VERSION_BRIGHT_ID=

# ── 공공데이터포털 (data.go.kr) ──────────────────────────────
# 아래 3개 서비스는 모두 동일한 data.go.kr 계정의 Decoding 키를 공유한다.
# Encoding / Decoding 키 중 Decoding 키를 사용
#   • 한국관광공사 TourAPI6.0 (KorService2) — https://www.data.go.kr 신청
#   • 두루누비 courseList (여행코스) — https://www.data.go.kr 신청
#   • 식품의약품안전처 식품영양성분 DB — https://www.data.go.kr 신청
DATA_GO_KEY=your_data_go_kr_decoding_key

# ── ODsay ───────────────────────────────────────────────
ODSAY_API_KEY=your_odsay_key

# ── TMAP (SK Open API) ──────────────────────────────────
# https://openapi.sk.com > 내 앱 > 앱 키 (App Key)
# 도보·자전거 경로 (보행자 전용 인도 데이터)
TMAP_APP_KEY=your_tmap_app_key