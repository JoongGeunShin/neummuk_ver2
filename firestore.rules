rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 기본 거부 ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── 유저 프로필 컬렉션 (최상위) ────────────────────────────
    // user_repository_impl.dart 경로:
    //   /{email}/user_entity             (이메일 로그인)
    //   /{uid}/user_entity               (익명 로그인)
    //   /{email}/user_profile_entity
    //   /{uid}/user_profile_entity
    // 컬렉션명이 본인의 이메일 또는 UID일 때만 허용.
    match /{colId}/{document} {
      allow read, write: if request.auth != null
        && (request.auth.uid == colId
            || request.auth.token.email == colId);
    }

    // ── 음식 카탈로그 (탐색 기능) ──────────────────────────────
    // food_catalog/{canonicalName}
    // - 읽기: 누구나 (익명 포함)
    // - 쓰기: 인증된 사용자만 (시드·캐싱·카운트 증가)
    // - search_count increment는 +1만 허용 (오남용 방지)
    match /food_catalog/{foodName} {
      allow read: if true;

      allow create: if request.auth != null;

      allow update: if request.auth != null
        && (
          // 일반 필드 업데이트 (시드, API 캐싱) — 이 요청이 search_count 자체를
          // 바꾸지 않으면 허용. (기존엔 결과 문서에 search_count 키가 "있기만 해도"
          // 막혀서, 이미 한 번이라도 검색된 적 있는 문서는 다른 필드조차 못 고치는
          // 버그가 있었다 — 시드 스크립트 재실행 시 기존 검색 카운트가 있는 문서를
          // 건드리기만 해도 전부 막혀 발견됨.)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['search_count'])
          // 또는 search_count가 아직 없던 문서에 0으로 최초 초기화하는 경우
          // (시드 스크립트가 예전 버그로 필드 자체가 안 생겼던 문서를 백필할 때 필요)
          || (!resource.data.keys().hasAny(['search_count'])
                && request.resource.data.search_count == 0)
          // 또는 search_count를 정확히 1 증가시키는 경우만 허용
          || (request.resource.data.search_count ==
                resource.data.get('search_count', 0) + 1)
        );

      // FoodFirestoreDatasource.pruneStale()이 검색 안 되는 오래된 항목을
      // batch.delete()로 정리한다 — 이 규칙이 없으면 그 삭제가 조용히 실패한다.
      allow delete: if request.auth != null;
    }

    // ── 음식 카테고리 (동적 카테고리 목록) ───────────────────────
    // food_categories/{categoryName}
    // - 읽기: 누구나 (카테고리 칩 로드)
    // - 쓰기: 인증된 사용자만 (새 카테고리 추가)
    match /food_categories/{catName} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── 일별 활동 기록 ───────────────────────────────────────
    // record_repository_impl.dart 경로:
    //   /users/{uid}/daily_records/{date}
    // 저장 허용 필드 화이트리스트 — GPS 좌표 필드 차단 (LAW_RESTRICT 준수).
    match /users/{uid}/daily_records/{date} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isValidDailyRecord(request.resource.data);

      // 회원 탈퇴 시 deleteUser()의 배치 삭제 허용 (request.resource가 없는 delete는
      // isValidDailyRecord 검증 대상이 아님).
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function isValidDailyRecord(data) {
      let allowed = ['date', 'steps', 'distanceM', 'caloriesKcal', 'updatedAt'];
      return data.keys().hasOnly(allowed)
        && data.steps is int
        && data.distanceM is number
        && data.caloriesKcal is number
        && data.steps >= 0
        && data.distanceM >= 0.0
        && data.caloriesKcal >= 0.0;
    }
  }
}
